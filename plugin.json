{
  "schemaVersion": 1,
  "pluginProtocol": 2,
  "id": "factory",
  "displayName": "Factory Background Studio",
  "exeName": "Factory Background Studio.exe",
  "pipeName": "\\\\.\\pipe\\background-studio-factory",
  "capabilities": {
    "commands": [
      "hello",
      "configure",
      "status",
      "apply",
      "pause",
      "restore",
      "shutdown"
    ],
    "mediaKinds": [
      "image",
      "video"
    ],
    "autoTakeover": true,
    "hotUpdate": true,
    "keepsTargetOnShutdown": true,
    "maxMediaBytes": 67108864
  },
  "settingsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "fit": {
        "type": "string",
        "title": "填充方式",
        "enum": [
          "cover",
          "contain",
          "fill",
          "tile"
        ],
        "enumLabels": [
          "覆盖",
          "适应",
          "拉伸",
          "平铺"
        ],
        "default": "cover"
      },
      "positionX": {
        "type": "number",
        "title": "水平位置",
        "minimum": 0,
        "maximum": 100,
        "step": 1,
        "default": 50
      },
      "positionY": {
        "type": "number",
        "title": "垂直位置",
        "minimum": 0,
        "maximum": 100,
        "step": 1,
        "default": 50
      },
      "opacity": {
        "type": "number",
        "title": "背景不透明度",
        "minimum": 0,
        "maximum": 1,
        "step": 0.01,
        "default": 0.72
      },
      "blur": {
        "type": "number",
        "title": "模糊",
        "minimum": 0,
        "maximum": 40,
        "step": 1,
        "default": 0
      },
      "scale": {
        "type": "number",
        "title": "缩放",
        "minimum": 1,
        "maximum": 1.3,
        "step": 0.01,
        "default": 1
      },
      "overlayColor": {
        "type": "string",
        "title": "遮罩颜色",
        "format": "color",
        "default": "#101416"
      },
      "overlayOpacity": {
        "type": "number",
        "title": "遮罩不透明度",
        "minimum": 0,
        "maximum": 0.9,
        "step": 0.01,
        "default": 0.12
      },
      "homeIntensity": {
        "type": "number",
        "title": "主页强度",
        "minimum": 0,
        "maximum": 1,
        "step": 0.01,
        "default": 1
      },
      "taskIntensity": {
        "type": "number",
        "title": "会话页强度",
        "minimum": 0,
        "maximum": 1,
        "step": 0.01,
        "default": 0.32
      },
      "sidebarOpacity": {
        "type": "number",
        "title": "侧栏不透明度",
        "minimum": 0,
        "maximum": 1,
        "step": 0.01,
        "default": 0.18
      },
      "surfaceOpacity": {
        "type": "number",
        "title": "画布不透明度",
        "minimum": 0,
        "maximum": 1,
        "step": 0.01,
        "default": 0.12
      },
      "cardOpacity": {
        "type": "number",
        "title": "卡片不透明度",
        "minimum": 0,
        "maximum": 1,
        "step": 0.01,
        "default": 0.35
      },
      "composerOpacity": {
        "type": "number",
        "title": "输入区不透明度",
        "minimum": 0,
        "maximum": 1,
        "step": 0.01,
        "default": 0.88
      },
      "menuOpacity": {
        "type": "number",
        "title": "菜单不透明度",
        "minimum": 0,
        "maximum": 1,
        "step": 0.01,
        "default": 0.9
      },
      "terminalOpacity": {
        "type": "number",
        "title": "代码与终端不透明度",
        "minimum": 0,
        "maximum": 1,
        "step": 0.01,
        "default": 0.9
      },
      "enabledOnHome": {
        "type": "boolean",
        "title": "主页启用",
        "default": true
      },
      "enabledOnTasks": {
        "type": "boolean",
        "title": "会话页启用",
        "default": true
      },
      "videoMuted": {
        "type": "boolean",
        "title": "视频静音",
        "default": true
      },
      "videoPlaybackRate": {
        "type": "number",
        "title": "视频倍速",
        "minimum": 0.25,
        "maximum": 2,
        "step": 0.05,
        "default": 1
      }
    }
  }
}
